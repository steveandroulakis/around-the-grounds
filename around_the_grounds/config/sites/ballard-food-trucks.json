{
  "key": "ballard-food-trucks",
  "name": "Ballard Food Trucks",
  "public_url": "https://ballardfoodtrucks.com",
  "calendar_max_timed_hours": 8,
  "template": "food-trucks",
  "timezone": "America/Los_Angeles",
  "target_repo": "https://github.com/steveandroulakis/ballard-food-trucks.git",
  "deploy_subdir": "public",
  "generate_description": true,
  "venues": [
    {
      "key": "stoup-ballard",
      "name": "Stoup Brewing - Ballard",
      "url": "https://www.stoupbrewing.com/ballard/",
      "source_type": "html",
      "parser_config": {
        "selectors": {
          "food_truck_entry": ".food-truck-day",
          "info_container": ".lunch-truck-info",
          "date": "h4",
          "time": ".hrs",
          "truck_name": ".truck"
        }
      }
    },
    {
      "key": "yonder-balebreaker",
      "name": "Yonder Cider & Bale Breaker - Ballard",
      "url": "https://www.bbycballard.com/food-trucks-1-1",
      "source_type": "html",
      "parser_config": {
        "note": "Uses Squarespace calendar API to fetch food truck events",
        "api_type": "squarespace_calendar"
      }
    },
    {
      "key": "obec-brewing",
      "name": "Obec Brewing",
      "url": "https://obecbrewing.com/",
      "source_type": "html",
      "parser_config": {
        "note": "Simple text format: 'Food truck: <name> <time>'",
        "pattern": "Food truck:\\s*([^0-9]+)\\s*(\\d{1,2}(?::\\d{2})?\\s*(?:[ap]m)?\\s*[-\u2013\u2014]\\s*\\d{1,2}(?::\\d{2})?\\s*(?:[ap]m)?)"
      }
    },
    {
      "key": "urban-family",
      "name": "Urban Family Brewing",
      "url": "https://urbanfamilybrewing.com/home/calendar/",
      "source_type": "html",
      "parser_config": {
        "note": "Primary source: WordPress Sugar Calendar HTML + AJAX; fallback to legacy Hivey API",
        "calendar_url": "https://urbanfamilybrewing.com/home/calendar/",
        "calendar_ajax_endpoint": "https://urbanfamilybrewing.com/wp-admin/admin-ajax.php",
        "api_endpoint": "https://hivey-api-prod-pineapple.onrender.com/urbanfamily/public-calendar",
        "api_type": "hivey_calendar"
      }
    },
    {
      "key": "wheelie-pop",
      "name": "Wheelie Pop Brewing",
      "url": "https://www.wheeliepopbrewing.com/seattle-ballard/",
      "source_type": "html",
      "parser_config": {
        "note": "Simple text format with dates and food truck names",
        "selectors": {
          "food_truck_text": "UPCOMING FOOD TRUCKS"
        }
      }
    },
    {
      "key": "channel-marker",
      "name": "Channel Marker Cider",
      "url": "https://docs.google.com/spreadsheets/d/e/2PACX-1vRaaJmiJ4YrKmvwiFdsHYij1kLUVP6394gMrTPpgHwu1zTtM5aoIy9JfLyeK4WrLLDDiHcFRAtbZci_/pub?output=csv",
      "source_type": "html",
      "parser_config": {
        "note": "Google Sheets CSV export with food truck schedule",
        "csv_direct": true
      }
    },
    {
      "key": "chucks-greenwood",
      "name": "Chuck's Hop Shop Greenwood",
      "url": "https://docs.google.com/spreadsheets/d/e/2PACX-1vS8BmXLSrsUVJ1x_x8FslWooOXRLeEJV-Jq5NzhfUCI9TtO-qXr0ey2BzY8KI-GflT7ekl5015XX3uj/pub?gid=1258996532&single=true&output=csv",
      "source_type": "html",
      "parser_config": {
        "note": "Google Sheets CSV export (published tab gid=1258996532, \"Greenwood\"). Do not use the \"GW Mobile\" tab (gid=1143085558): its time columns render as \"12 AM\".",
        "csv_direct": true,
        "event_type_filter": "Food Truck"
      }
    },
    {
      "key": "lucky-envelope",
      "name": "Lucky Envelope Brewing",
      "url": "https://www.luckyenvelopebrewing.com/",
      "source_type": "html",
      "parser_config": {
        "note": "Squarespace page with embedded JSON in data-current-context carousel attribute"
      }
    },
    {
      "key": "salehs-corner",
      "name": "Saleh's Corner",
      "url": "https://www.seattlefoodtruck.com/api/events",
      "source_type": "html",
      "parser_config": {
        "note": "Seattle Food Truck API with structured JSON responses",
        "api_type": "seattle_food_truck",
        "location_id": 164,
        "date_format": "M-D-YY"
      }
    }
  ]
}
